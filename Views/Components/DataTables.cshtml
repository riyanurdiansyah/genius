@{
    ViewData["Title"] = "DataTables";
}

@section Styles {

    <link rel="stylesheet" href="~/lib/datatables/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/lib/datatables/css/select.dataTables.min.css">
    <link rel="stylesheet" href="~/lib/datatables/css/fixedColumns.dataTables.min.css">
