    const ta = document.getElementById('jsonInput');
    let autoRenderTimer = null;
    ta.addEventListener('input', function () {
        updateLineNumbers();
        const c = this.value.length, l = this.value.split('\n').length;
        document.getElementById('jsonInfo').textContent = `${c.toLocaleString()} characters · ${l.toLocaleString()} lines`;
        // live validate
        const errEl = document.getElementById('jsonError');
        const status = document.getElementById('jsonStatus');
        if (!this.value.trim()) {
            errEl.style.display = 'none';
            status.innerHTML = '<i class="fas fa-circle me-1" style="font-size:8px;"></i>Ready';
            status.style.background = '#e8f5e9'; status.style.color = '#2e7d32';
            return;
        }
        try {
            JSON.parse(this.value);
            errEl.style.display = 'none';
            status.innerHTML = '<i class="fas fa-circle me-1" style="font-size:8px;"></i>Valid ⚡ Auto';
            status.style.background = '#e8f5e9'; status.style.color = '#2e7d32';
            // debounced auto-render (600ms after user stops typing)
            clearTimeout(autoRenderTimer);
            autoRenderTimer = setTimeout(() => renderFromInput(), 600);
        } catch (e) {
            status.innerHTML = '<i class="fas fa-circle me-1" style="font-size:8px;"></i>Invalid';
            status.style.background = '#ffebee'; status.style.color = '#c62828';
            errEl.textContent = '✖ ' + e.message;
            errEl.style.display = 'inline';
            clearTimeout(autoRenderTimer);
        }
    });

    ta.addEventListener('scroll', function () {
        document.getElementById('lineNumbers').scrollTop = this.scrollTop;
    });

    ta.addEventListener('keydown', function (e) {
        if (e.key === 'Tab') {
            e.preventDefault();
            const s = this.selectionStart, end = this.selectionEnd;
            this.value = this.value.substring(0, s) + '  ' + this.value.substring(end);
            this.selectionStart = this.selectionEnd = s + 2;
        }
    });

    /* ── toast ────────────────────────────────────────────────────── */
    function showToast(msg) {
        let t = document.getElementById('jrToast');
        if (!t) {
            t = document.createElement('div');
            t.id = 'jrToast';
            t.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#333;color:#fff;padding:10px 20px;border-radius:10px;font-size:13px;z-index:9999;opacity:0;transition:opacity .3s;pointer-events:none;';
            document.body.appendChild(t);
        }
        t.textContent = msg;
        t.style.opacity = '1';
        clearTimeout(t._to);
        t._to = setTimeout(() => { t.style.opacity = '0'; }, 2000);
    }

    /* ── presets gallery ──────────────────────────────────────────── */
    function loadPreset(key) {
        const s = SAMPLES[key];
        const ta = document.getElementById('jsonInput');
        ta.value = s.json;
        // set mode (includes 'form' mode)
        const modeMap = { auto:'modeAuto', table:'modeTable', card:'modeCard', tree:'modeTree', list:'modeList', form:'modeForm' };
        const radio = document.getElementById(modeMap[s.mode] || 'modeAuto');
        if (radio) radio.checked = true;
        updateLineNumbers();
        ta.dispatchEvent(new Event('input'));
        renderFromInput();
    }

    const presetContainer = document.getElementById('samplePresets');
    Object.keys(SAMPLES).forEach(key => {
        const s = SAMPLES[key];
        const col = document.createElement('div');
        col.className = 'col-6 col-md-4 col-lg-2';
        col.innerHTML = `<div class="preset-card" id="preset-${key}">
            <div class="preset-icon">${s.icon}</div>
            <div class="preset-name">${s.label}</div>
            <div class="preset-desc">${s.desc}</div>
        </div>`;
        col.querySelector('.preset-card').addEventListener('click', () => loadPreset(key));
        presetContainer.appendChild(col);
    });

    /* ── init ─────────────────────────────────────────────────────── */
    updateLineNumbers();
})();
</script>
