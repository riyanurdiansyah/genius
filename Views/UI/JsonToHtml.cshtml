@{
    ViewData["Title"] = "JSON to HTML Renderer";
}

@section Styles {
    <link rel="stylesheet" href="~/css/kuda-json-renderer.css" />
}

<div class="alert alert-primary mb-4 border-0 shadow-sm d-flex align-items-center p-4" style="background: var(--sb-primary-light); border-radius: 16px;">
    <div class="flex-shrink-0 me-3">
        <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
            <i class="fa-solid fa-code text-primary fs-4"></i>
        </div>
    </div>
    <div>
        <h5 class="alert-heading mb-1 fw-bold text-primary">JSON to HTML Renderer</h5>
        <p class="mb-0 text-secondary" style="font-size: 14px;">
            Paste complex JSON and transform it into structured, readable HTML. Supports nested objects, arrays, tables, and custom templates.
        </p>
    </div>
</div>

<!-- Top Controls -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-3 d-flex flex-wrap gap-2 align-items-center">
                <span class="fw-semibold text-muted me-2" style="font-size: 13px;"><i class="fas fa-sliders-h me-1"></i> Render Mode:</span>
                <div class="btn-group" role="group" id="renderModeGroup">
                    <input type="radio" class="btn-check" name="renderMode" id="modeAuto" value="auto" checked>
                    <label class="btn btn-sm btn-outline-primary" for="modeAuto"><i class="fas fa-magic me-1"></i>Auto</label>

                    <input type="radio" class="btn-check" name="renderMode" id="modeTable" value="table">
                    <label class="btn btn-sm btn-outline-primary" for="modeTable"><i class="fas fa-table me-1"></i>Table</label>

                    <input type="radio" class="btn-check" name="renderMode" id="modeCard" value="card">
                    <label class="btn btn-sm btn-outline-primary" for="modeCard"><i class="fas fa-id-card me-1"></i>Cards</label>

                    <input type="radio" class="btn-check" name="renderMode" id="modeTree" value="tree">
                    <label class="btn btn-sm btn-outline-primary" for="modeTree"><i class="fas fa-sitemap me-1"></i>Tree</label>

                    <input type="radio" class="btn-check" name="renderMode" id="modeList" value="list">
                    <label class="btn btn-sm btn-outline-primary" for="modeList"><i class="fas fa-list me-1"></i>List</label>

                    <input type="radio" class="btn-check" name="renderMode" id="modeForm" value="form">
                    <label class="btn btn-sm btn-outline-primary" for="modeForm"><i class="fas fa-clipboard-list me-1"></i>Form</label>
                </div>

                <div class="ms-auto d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" id="btnLoadSample">
                        <i class="fas fa-database me-1"></i> Load Sample
                    </button>
                    <button class="btn btn-sm btn-outline-danger" id="btnClearAll">
                        <i class="fas fa-trash-alt me-1"></i> Clear
                    </button>
                    <button class="btn btn-sm btn-primary" id="btnRender">
                        <i class="fas fa-play me-1"></i> Render HTML
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Editor Layout -->
<div class="row g-3">
    <!-- Left: JSON Editor -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
            <div class="card-header border-0 d-flex align-items-center justify-content-between px-4 py-3" style="background: transparent;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--sb-primary-light);">
                        <i class="fas fa-file-code text-primary" style="font-size:13px;"></i>
                    </div>
                    <span class="fw-bold" style="font-size:14px;">JSON Input</span>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span id="jsonStatus" class="badge rounded-pill" style="font-size:11px; background:#e8f5e9; color:#2e7d32;">
                        <i class="fas fa-circle me-1" style="font-size:8px;"></i>Ready
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" id="btnFormatJson" title="Format JSON">
                        <i class="fas fa-align-left"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" id="btnCopyJson" title="Copy JSON">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="jsonEditorWrapper" style="position:relative;">
                    <div id="lineNumbers" class="json-line-numbers" aria-hidden="true"></div>
                    <textarea id="jsonInput" class="json-editor-textarea" placeholder='Paste your JSON here...&#10;{&#10;  "name": "example",&#10;  "items": [...]&#10;}'
                        spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
                </div>
            </div>
            <div class="card-footer border-0 px-4 py-2" style="background:transparent;">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted" id="jsonInfo">0 characters · 0 lines</small>
                    <small class="text-danger" id="jsonError" style="display:none;"></small>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: HTML Output -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
            <div class="card-header border-0 d-flex align-items-center justify-content-between px-4 py-3" style="background: transparent;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:#fff3e0;">
                        <i class="fas fa-eye" style="font-size:13px; color:#e65100;"></i>
                    </div>
                    <span class="fw-bold" style="font-size:14px;">HTML Output</span>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary active" id="btnPreviewMode" title="Preview">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="btn btn-outline-secondary" id="btnCodeMode" title="View HTML Code">
                            <i class="fas fa-code"></i>
                        </button>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" id="btnCopyHtml" title="Copy snippet (tanpa CSS)">
                        <i class="fas fa-copy me-1"></i><span style="font-size:11px;">Snippet</span>
                    </button>
                    <button class="btn btn-sm btn-primary" id="btnCopyForWeb" title="Copy HTML lengkap siap pakai (dengan CSS embedded)">
                        <i class="fas fa-globe me-1"></i><span style="font-size:11px;">Copy for Web</span>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" id="btnDownloadHtml" title="Download sebagai file HTML standalone">
                        <i class="fas fa-download"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-3 d-flex flex-column" style="min-height:450px;">
                <!-- Preview Panel -->
                <div id="htmlPreview" class="html-output-wrapper flex-grow-1">
                    <div class="empty-state-placeholder">
                        <div class="placeholder-icon">
                            <i class="fas fa-magic"></i>
                        </div>
                        <div class="placeholder-text">Your rendered output will appear here</div>
                        <div class="placeholder-sub">Paste JSON on the left and click <strong>Render HTML</strong></div>
                    </div>
                </div>
                <!-- Code Panel -->
                <div id="htmlCodePanel" style="display:none; flex-grow:1;">
                    <pre id="htmlCodeOutput" class="html-code-output"></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Schema / Field Mapping Card -->
<div class="row mt-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-header border-0 px-4 py-3 d-flex align-items-center justify-content-between" style="background:transparent;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:#f3e5f5;">
                        <i class="fas fa-sliders-h" style="font-size:13px; color:#7b1fa2;"></i>
                    </div>
                    <span class="fw-bold" style="font-size:14px;">Detected Schema & Field Options</span>
                </div>
                <button class="btn btn-sm btn-outline-secondary" id="btnToggleSchema">
                    <i class="fas fa-chevron-down" id="schemaChevron"></i>
                </button>
            </div>
            <div id="schemaPanel" class="card-body px-4 pb-4 pt-0">
                <div id="schemaContent" class="text-muted" style="font-size:14px;">
                    <em>Render JSON to detect schema fields.</em>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Examples Gallery -->
<div class="row mt-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-header border-0 px-4 py-3" style="background:transparent;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:#e3f2fd;">
                        <i class="fas fa-shapes" style="font-size:13px; color:#1565c0;"></i>
                    </div>
                    <span class="fw-bold" style="font-size:14px;">Sample Data Presets</span>
                </div>
            </div>
            <div class="card-body px-4 pb-4 pt-0">
                <div class="row g-3" id="samplePresets">
                    <!-- filled by JS -->
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ─── Editor ─────────────────────────────────────────────── */
    #jsonEditorWrapper {
        display: flex;
        position: relative;
        background: #1e1e2e;
        border-radius: 0 0 0 16px;
        overflow: hidden;
        height: 450px;
    }

    .json-line-numbers {
        padding: 14px 8px 14px 14px;
        font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
        font-size: 13px;
        line-height: 1.7;
        color: #555577;
        text-align: right;
        user-select: none;
        min-width: 42px;
        background: #1e1e2e;
        border-right: 1px solid #2a2a3e;
        overflow: hidden;
    }

    .json-editor-textarea {
        flex: 1;
        background: #1e1e2e;
        color: #cdd6f4;
        border: none;
        outline: none;
        resize: none;
        padding: 14px 16px;
        font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
        font-size: 13px;
        line-height: 1.7;
        tab-size: 2;
        white-space: pre;
        overflow-wrap: normal;
        overflow-x: auto;
        width: 100%;
    }

    .json-editor-textarea::placeholder { color: #444466; }

    /* ─── Output ─────────────────────────────────────────────── */
    .html-output-wrapper {
        overflow: auto;
        padding: 8px;
        background: #fafafa;
        border-radius: 12px;
        border: 1px solid #e9ecef;
        min-height: 420px;
    }

    .html-code-output {
        background: #1e1e2e;
        color: #a6e3a1;
        border-radius: 12px;
        padding: 16px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.6;
        overflow: auto;
        min-height: 420px;
        margin: 0;
        white-space: pre-wrap;
        word-break: break-word;
    }

    /* ─── Placeholder ─────────────────────────────────────────── */
    .empty-state-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 380px;
        color: #bbb;
        text-align: center;
        gap: 10px;
    }

    .placeholder-icon {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        color: var(--sb-primary);
        margin-bottom: 8px;
        animation: pulse-icon 2.5s ease-in-out infinite;
    }

    @@keyframes pulse-icon {
        0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(76,175,80,.3); }
        50% { transform: scale(1.06); box-shadow: 0 0 0 10px rgba(76,175,80,0); }
    }

    .placeholder-text { font-size: 15px; font-weight: 600; color: #888; }
    .placeholder-sub  { font-size: 13px; color: #bbb; }

    /* ─── Schema ─────────────────────────────────────────────── */
    .schema-field-pill {
        display: inline-flex; align-items: center; gap: 6px;
        background: #f5f5f5; border: 1px solid #e0e0e0;
        border-radius: 20px; padding: 4px 12px;
        font-size: 12px; font-weight: 600; cursor: default; margin: 3px;
    }
    .schema-field-pill .type-badge { padding: 1px 7px; border-radius: 12px; font-size: 10px; font-weight: 700; }
    .type-string  { background:#fff8e1; color:#e65100; }
    .type-number  { background:#e3f2fd; color:#1565c0; }
    .type-boolean { background:#f3e5f5; color:#6a1b9a; }
    .type-object  { background:#e8f5e9; color:#2e7d32; }
    .type-array   { background:#fce4ec; color:#880e4f; }
    .type-null    { background:#eceff1; color:#546e7a; }

    /* ─── Sample Presets ─────────────────────────────────────── */
    .preset-card {
        border: 1px solid #e9ecef; border-radius: 12px; padding: 14px;
        cursor: pointer; transition: all .2s; background: #fff;
    }
    .preset-card:hover { border-color: var(--sb-primary); box-shadow: 0 4px 14px rgba(0,0,0,.1); transform: translateY(-2px); }
    .preset-card .preset-icon { font-size: 22px; margin-bottom: 8px; }
    .preset-card .preset-name { font-weight: 700; font-size: 13px; color: #333; }
    .preset-card .preset-desc { font-size: 11px; color: #888; margin-top: 4px; }
</style>

