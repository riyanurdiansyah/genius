    /* ── schema renderer ──────────────────────────────────────────── */
    function renderSchema(schema) {
        const el = document.getElementById('schemaContent');
        const keys = Object.keys(schema);
        if (!keys.length) { el.innerHTML = '<em class="text-muted">No fields detected.</em>'; return; }
        el.innerHTML = keys.map(k => {
            const { type } = schema[k];
            return `<span class="schema-field-pill">${KudaRenderer.escHtml(k)}<span class="type-badge type-${type}">${type}</span></span>`;
        }).join('');
    }

