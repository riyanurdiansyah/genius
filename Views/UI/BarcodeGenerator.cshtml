@{ ViewData["Title"] = "Barcode Generator"; }

<div class="row g-4 mb-5">
    <div class="col-12">
        <h4 class="fw-bold mb-1">Barcode & QR Generator</h4>
        <p class="text-muted">Generate various barcode formats and QR codes with custom styling.</p>
    </div>

    <!-- Generator UI -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="fas fa-barcode me-2 text-primary"></i>Configuration</h5>
                <button class="btn btn-sm btn-outline-primary copy-btn" data-target="barcodeGeneratorSnippet"><i class="fa-regular fa-copy"></i> Copy HTML</button>
            </div>
            <div class="card-body" id="barcodeGeneratorSnippet">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label small fw-semibold text-muted">Data / URL</label>
                        <textarea id="bcText" class="form-control" rows="2" placeholder="Enter text or URL here..." oninput="debounceGenerate()"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Symbology</label>
                        <select id="bcid" class="form-select" onchange="generateBarcode()">
                            <optgroup label="Popular">
                                <option value="code128">Code 128</option>
                                <option value="qrcode" selected>QR Code</option>
                                <option value="ean13">EAN-13</option>
                            </optgroup>
                            <optgroup label="Others">
                                <option value="code39">Code 39</option>
                                <option value="datamatrix">Data Matrix</option>
                                <option value="pdf417">PDF417</option>
                            </optgroup>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Scale / Size</label>
                        <div class="d-flex align-items-center">
                            <input type="range" class="form-range" id="bcScale" min="1" max="10" value="3" oninput="generateBarcode()">
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted">Line Color</label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color w-100" id="bcColor" value="#000000" title="Choose color">
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted">Background</label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color w-100" id="bcBgColor" value="#ffffff" title="Choose background">
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted">Height</label>
                        <input type="number" class="form-control" id="bcHeight" value="10" placeholder="Height" oninput="generateBarcode()">
                    </div>

                    <div class="col-12 mt-4 pt-2 border-top">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="bcIncludeText" checked onchange="generateBarcode()">
                            <label class="form-check-label ms-2" for="bcIncludeText">Include Human Readable Text</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Preview Area -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100 bg-white d-flex flex-column">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="mb-0 fw-bold"><i class="fas fa-eye me-2 text-primary"></i>Live Preview</h5>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5">
                <div id="emptyState" class="text-muted">
                    <i class="fas fa-qrcode fa-4x mb-3 opacity-25"></i>
                    <p class="mb-0">Waiting for data input...</p>
                </div>

                <div id="previewCard" class="p-3 rounded border d-none shadow-sm bg-white" style="transition: all 0.3s ease;">
                    <canvas id="barcodeCanvas"></canvas>
                </div>

                <div id="errorMsg" class="text-danger small mt-3 d-none"></div>

                <div id="previewActions" class="mt-4 d-none">
                    <button class="btn btn-outline-dark btn-sm px-3 rounded-pill me-2" onclick="downloadBarcode('png')">
                        <i class="fas fa-download me-2"></i>Download PNG
                    </button>
                </div>
            </div>
            <div class="card-footer bg-light border-0 py-3 text-center">
                <p class="small text-muted mb-0">Powered by BWIP-JS Engine</p>
            </div>
        </div>
    </div>
</div>
