@{
    ViewData["Title"] = "Cards";
}

<style>
.section-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--primary); margin-bottom: 6px; }
.section-desc { font-size: 14px; color: #64748b; margin-bottom: 24px; }
[data-theme="dark"] .section-desc { color: #94a3b8; }

/* ── Base Card ── */
.kuda-card { background: #fff; border-radius: 16px; border: 1px solid #f1f5f9; box-shadow: 0 2px 12px rgba(0,0,0,0.04); overflow: hidden; transition: all 0.3s ease; }
[data-theme="dark"] .kuda-card { background: #112e27; border-color: var(--border-color); }
.kuda-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.08); }
.kuda-card .card-body { padding: 24px; }
.kuda-card .card-img { width: 100%; height: 180px; object-fit: cover; }

/* ── Gradient Card ── */
.card-gradient { border: none; color: #fff; }
.card-gradient-primary { background: linear-gradient(135deg, #3b9d82 0%, #1a5c4e 100%); }
.card-gradient-purple { background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%); }
.card-gradient-orange { background: linear-gradient(135deg, #f59e0b 0%, #b45309 100%); }
.card-gradient-rose { background: linear-gradient(135deg, #f43f5e 0%, #9f1239 100%); }
.card-gradient .card-body { padding: 28px; }
.card-gradient .card-icon { font-size: 2.5rem; opacity: 0.3; position: absolute; right: 20px; top: 20px; }

/* ── Glass Card ── */
.card-glass {
    background: rgba(255,255,255,0.15) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.25) !important;
    box-shadow: 0 8px 32px rgba(0,0,0,0.1) !important;
    color: #1e293b;
}
[data-theme="dark"] .card-glass { background: rgba(17,46,39,0.5) !important; border-color: rgba(59,157,130,0.2) !important; }

/* ── Stats Card ── */
.card-stats .stat-value { font-size: 2rem; font-weight: 800; line-height: 1; color: #1e293b; }
[data-theme="dark"] .card-stats .stat-value { color: #f1f5f9; }
.card-stats .stat-label { font-size: 12px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
.card-stats .stat-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 700; padding: 3px 8px; border-radius: 20px; margin-top: 8px; }
.stat-badge.up { background: rgba(16,185,129,0.1); color: #059669; }
.stat-badge.down { background: rgba(239,68,68,0.1); color: #dc2626; }
.card-stats .stat-icon { width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }

/* ── Profile Card ── */
.card-profile { text-align: center; }
.card-profile .profile-cover { height: 90px; background: linear-gradient(135deg, #3b9d82, #1a5c4e); position: relative; }
.card-profile .profile-avatar { width: 72px; height: 72px; border-radius: 50%; border: 4px solid #fff; margin: -36px auto 12px; position: relative; z-index: 1; object-fit: cover; }
[data-theme="dark"] .card-profile .profile-avatar { border-color: #112e27; }
.card-profile .profile-name { font-weight: 700; font-size: 15px; color: #1e293b; }
[data-theme="dark"] .card-profile .profile-name { color: #f1f5f9; }
.card-profile .profile-role { font-size: 12px; color: #94a3b8; margin-bottom: 16px; }
.card-profile .profile-stat { font-size: 13px; font-weight: 700; color: #1e293b; }
[data-theme="dark"] .card-profile .profile-stat { color: #e2e8f0; }
.card-profile .profile-stat-label { font-size: 11px; color: #94a3b8; }
.card-profile .btn-follow { background: #3b9d82; color: #fff; border: none; border-radius: 10px; padding: 8px 24px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.card-profile .btn-follow:hover { background: #2d7a65; transform: translateY(-1px); }

/* ── Pricing Card ── */
.card-pricing { text-align: center; }
.card-pricing.featured { border-color: var(--primary) !important; box-shadow: 0 0 0 3px rgba(59,157,130,0.15), 0 12px 30px rgba(59,157,130,0.15) !important; }
.card-pricing .price-badge { display: inline-block; background: rgba(59,157,130,0.1); color: var(--primary); font-size: 11px; font-weight: 700; padding: 4px 12px; border-radius: 20px; margin-bottom: 12px; }
.card-pricing.featured .price-badge { background: var(--primary); color: #fff; }
.card-pricing .price-amount { font-size: 3rem; font-weight: 800; color: #1e293b; line-height: 1; }
[data-theme="dark"] .card-pricing .price-amount { color: #f1f5f9; }
.card-pricing .price-period { font-size: 14px; color: #94a3b8; }
.card-pricing .price-feature { font-size: 13px; color: #475569; padding: 8px 0; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; gap: 10px; }
[data-theme="dark"] .card-pricing .price-feature { color: #94a3b8; border-bottom-color: rgba(255,255,255,0.05); }
.card-pricing .price-feature i { color: #3b9d82; }
.btn-plan { width: 100%; padding: 12px; border: 2px solid #3b9d82; border-radius: 12px; background: transparent; color: #3b9d82; font-weight: 700; font-size: 14px; cursor: pointer; transition: all 0.2s; margin-top: 20px; }
.btn-plan:hover, .featured .btn-plan { background: #3b9d82; color: #fff; }

/* ── Horizontal Card ── */
.card-horizontal { display: flex; gap: 0; }
.card-horizontal .card-img-side { width: 130px; min-height: 130px; object-fit: cover; flex-shrink: 0; }

/* ── Notification Card ── */
.card-notification .notif-item { display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid #f1f5f9; }
[data-theme="dark"] .card-notification .notif-item { border-color: rgba(255,255,255,0.05); }
.card-notification .notif-item:last-child { border-bottom: none; }
.card-notification .notif-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
.card-notification .notif-text { font-size: 13px; color: #475569; line-height: 1.4; }
[data-theme="dark"] .card-notification .notif-text { color: #94a3b8; }
.card-notification .notif-time { font-size: 11px; color: #cbd5e1; margin-top: 2px; }

/* ── Progress Card ── */
.card-progress .prog-label { font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; }
[data-theme="dark"] .card-progress .prog-label { color: #94a3b8; }
.card-progress .prog-bar-track { height: 6px; background: #f1f5f9; border-radius: 10px; overflow: hidden; }
[data-theme="dark"] .card-progress .prog-bar-track { background: rgba(255,255,255,0.06); }
.card-progress .prog-bar-fill { height: 100%; border-radius: 10px; transition: width 1s ease; }

/* ── Glassmorphism BG ── */
.glass-bg { background: linear-gradient(135deg, #3b9d82 0%, #1a5c4e 50%, #7c3aed 100%); border-radius: 20px; padding: 32px; position: relative; overflow: hidden; }
.glass-bg::before { content: ''; position: absolute; width: 200px; height: 200px; background: rgba(255,255,255,0.05); border-radius: 50%; top: -60px; right: -60px; }
.glass-bg::after { content: ''; position: absolute; width: 150px; height: 150px; background: rgba(255,255,255,0.05); border-radius: 50%; bottom: -40px; left: -40px; }
</style>

