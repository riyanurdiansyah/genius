@{ ViewData["Title"] = "Developer Hub"; }

@section Styles {
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
<style>
    :root {
        --kd-primary: #3b9d82;
        --kd-primary-rgb: 59, 157, 130;
        --kd-secondary: #1e293b;
        --kd-accent: #10b981;
        --kd-bg: #f8fafc;
        --kd-card-bg: #ffffff;
        --kd-text: #334155;
        --kd-text-light: #64748b;
        --kd-border: #e2e8f0;
        --kd-dark-bg: #0f172a;
        --kd-code-bg: #011627;
        --kd-font-stack: 'KalbeGeometric', 'KalbeHelix', 'KalbeRounded', sans-serif;
    }

    [data-theme="dark"] {
        --kd-bg: #050b0a;
        --kd-card-bg: #0d221d;
        --kd-text: #e2e8f0;
        --kd-text-light: #94a3b8;
        --kd-border: rgba(59, 157, 130, 0.15);
    }

    body {
        font-family: var(--kd-font-stack);
        background-color: var(--kd-bg);
        color: var(--kd-text);
        scroll-behavior: smooth;
    }

    /* ── Header Hero ── */
    .hero-banner {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        padding: 4rem 2rem;
        border-radius: 24px;
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    .hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -20%;
        width: 100%;
        height: 200%;
        background: radial-gradient(circle, rgba(59, 157, 130, 0.1) 0%, transparent 70%);
        transform: rotate(-15deg);
    }

    .hero-title {
        font-family: var(--kd-font-stack);
        font-weight: 800;
        font-size: 2.8rem;
        color: #fff;
        margin-bottom: 1rem;
        letter-spacing: -1px;
    }

    .hero-subtitle {
        font-family: var(--kd-font-stack);
        color: #94a3b8;
        font-size: 1.1rem;
        max-width: 600px;
    }

    /* ── Layout ── */
    .doc-container {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 2.5rem;
    }

    /* ── Sticky Nav ── */
    .sidebar-nav {
        position: sticky;
        top: 2rem;
        height: fit-content;
    }

    .nav-group-label {
        font-family: var(--kd-font-stack);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--kd-text-light);
        margin: 1.5rem 0 0.75rem 0.5rem;
    }

    .doc-link {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        color: var(--kd-text);
        text-decoration: none !important;
        border-radius: 12px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        font-weight: 500;
        border: 1px solid transparent;
    }

    .doc-link i {
        width: 20px;
        margin-right: 12px;
        font-size: 1rem;
        color: var(--kd-text-light);
        transition: color 0.2s;
    }

    .doc-link:hover {
        background: rgba(59, 157, 130, 0.08);
        color: var(--kd-primary);
    }

    .doc-link.active {
        background: var(--kd-primary);
        color: #fff;
        box-shadow: 0 4px 12px rgba(59, 157, 130, 0.25);
    }

    .doc-link.active i {
        color: #fff;
    }

    /* ── Sections & Cards ── */
    .section-card {
        background: var(--kd-card-bg);
        border: 1px solid var(--kd-border);
        border-radius: 20px;
        padding: 2.5rem;
        margin-bottom: 2.5rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .section-icon {
        width: 48px;
        height: 48px;
        background: rgba(59, 157, 130, 0.1);
        color: var(--kd-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 1.25rem;
    }

    .section-title {
        font-weight: 700;
        font-size: 1.6rem;
        margin: 0;
    }

    /* ── Setup Steps ── */
    .step-box {
        position: relative;
        padding: 1.5rem;
        background: #f1f5f9;
        border-radius: 16px;
        margin-bottom: 1.5rem;
        border: 1px solid rgba(0,0,0,0.03);
    }
    
    [data-theme="dark"] .step-box { background: #050b0a; border-color: rgba(59, 157, 130, 0.1); }

    .step-tag {
        font-family: var(--kd-font-stack);
        position: absolute;
        top: -12px;
        left: 1.5rem;
        background: var(--kd-primary);
        color: #fff;
        font-weight: 800;
        font-size: 0.75rem;
        padding: 4px 14px;
        border-radius: 20px;
        box-shadow: 4px 4px 10px rgba(59, 157, 130, 0.2);
    }

    /* ── Code Styling ── */
    .code-container {
        margin: 1.5rem 0;
        background: var(--kd-code-bg);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #1e293b;
    }

    .code-header {
        background: #011221;
        padding: 0.75rem 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #1e293b;
    }

    .code-lang {
        font-family: 'Fira Code', monospace;
        font-size: 0.7rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-copy {
        background: transparent;
        border: 1px solid #334155;
        color: #94a3b8;
        font-size: 0.75rem;
        padding: 4px 12px;
        border-radius: 6px;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-copy:hover {
        background: #1e293b;
        color: #fff;
    }

    pre {
        margin: 0;
        padding: 1.5rem;
        font-family: 'Fira Code', monospace;
        font-size: 0.9rem;
        line-height: 1.7;
        color: #a5d6ff;
        overflow-x: auto;
    }

    .t-tag { color: #7ee787; }
    .t-attr { color: #79c0ff; }
    .t-val { color: #f2cc60; }
    .t-cm { color: #8b949e; font-style: italic; }

    /* ── Feature Grid ── */
    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .feature-item {
        display: flex;
        align-items: center;
        padding: 1rem;
        background: rgba(59, 157, 130, 0.05);
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .feature-item i {
        color: var(--kd-primary);
        margin-right: 10px;
    }

    /* ── Responsive ── */
    @@media (max-width: 992px) {
        .doc-container { grid-template-columns: 1fr; }
        .sidebar-nav { display: none; }
    }

</style>
}

<div class="hero-banner">
    <h1 class="hero-title">Kuda Kit Developer Hub</h1>
    <p class="hero-subtitle">Membangun dashboard enterprise kelas industri dengan satu bundle CDN. Cepat, Berwarna, dan Siap Produksi.</p>
</div>

<div class="doc-container">
    
    <aside class="sidebar-nav">
        <div class="nav-group-label">Memulai</div>
        <a href="#quickstart" class="doc-link active"><i class="fas fa-bolt"></i> Quick Start</a>
        <a href="#dependencies" class="doc-link"><i class="fas fa-layer-group"></i> Ecosystem</a>
        
        <div class="nav-group-label">Panduan Integrasi</div>
        <a href="#setup" class="doc-link"><i class="fas fa-code"></i> Setup Script</a>
        <a href="#layout" class="doc-link"><i class="fas fa-desktop"></i> Core Layout</a>
        
        <div class="nav-group-label">API Reference</div>
        <a href="#api-datatable" class="doc-link"><i class="fas fa-table"></i> DataTables</a>
        <a href="#api-charts" class="doc-link"><i class="fas fa-chart-line"></i> ApexCharts</a>
        <a href="#api-maps" class="doc-link"><i class="fas fa-map"></i> Global Maps</a>
    </aside>

    <main class="content-wrapper">

        <section id="quickstart" class="section-card">
            <div class="section-header">
                <div class="section-icon"><i class="fas fa-wind"></i></div>
                <h2 class="section-title">Metode Integrasi Cepat</h2>
            </div>
            <p class="text-muted text-lg mb-4">Lupakan install puluhan npm packages. Kuda Kit memberikan semua yang Anda butuhkan (Bootstrap, DataTables, Apex, Leaflet, Select2) dalam **dua baris kode**.</p>
            
            <div class="step-box">
                <span class="step-tag">Styles</span>
                <p class="small text-muted mb-3 fw-semibold">Tambahkan di dalam tag <code>&lt;head&gt;</code>:</p>
                <div class="code-container">
                    <div class="code-header">
                        <span class="code-lang">HTML</span>
                        <button class="btn-copy">Copy</button>
                    </div>
                    <pre><code>&lt;<span class="t-tag">link</span> <span class="t-attr">rel</span>=<span class="t-val">"stylesheet"</span> <span class="t-attr">href</span>=<span class="t-val">"/kuda-cdn/css/kuda-kit.css"</span>&gt;</code></pre>
                </div>
            </div>

            <div class="step-box">
                <span class="step-tag">Scripts</span>
                <p class="small text-muted mb-3 fw-semibold">Tambahkan di akhir tag <code>&lt;body&gt;</code> sebelum penutup:</p>
                <div class="code-container">
                    <div class="code-header">
                        <span class="code-lang">HTML</span>
                        <button class="btn-copy">Copy</button>
                    </div>
                    <pre><code>&lt;<span class="t-tag">script</span> <span class="t-attr">src</span>=<span class="t-val">"/kuda-cdn/js/kuda-kit.js"</span>&gt;&lt;/<span class="t-tag">script</span>&gt;</code></pre>
                </div>
            </div>
        </section>

        <section id="dependencies" class="section-card">
            <div class="section-header">
                <div class="section-icon"><i class="fas fa-cubes"></i></div>
                <h2 class="section-title">Ecosystem Bundle</h2>
            </div>
            <p class="text-muted mb-4">Setiap bundle Kuda Kit menyertakan library standar industri versi terbaru yang sudah di-bundle khusus untuk performa maksimal.</p>
            
            <div class="feature-grid">
                <div class="feature-item"><i class="fab fa-bootstrap"></i> Bootstrap 5.3.2</div>
                <div class="feature-item"><i class="fas fa-table"></i> DataTables 1.13</div>
                <div class="feature-item"><i class="fas fa-chart-area"></i> ApexCharts JS</div>
                <div class="feature-item"><i class="fas fa-map"></i> Leaflet v1.9</div>
                <div class="feature-item"><i class="fas fa-list"></i> Select2 Full</div>
                <div class="feature-item"><i class="fas fa-code"></i> CodeMirror</div>
                <div class="feature-item"><i class="fas fa-font-awesome"></i> FontAwesome 6</div>
                <div class="feature-item"><i class="fas fa-arrows-to-dot"></i> Sortable JS</div>
            </div>
        </section>

        <section id="layout" class="section-card">
            <div class="section-header">
                <div class="section-icon"><i class="fas fa-object-group"></i></div>
                <h2 class="section-title">Anatomi Layout Kuda</h2>
            </div>
            <p class="text-muted mb-4">Kuda Kit bekerja secara optimal dengan struktur Flexbox wrapper berikut untuk menjaga sidebar tetap responsif dan transisi dark mode yang halus.</p>
            
            <div class="code-container">
                <div class="code-header">
                    <span class="code-lang">index.html</span>
                    <button class="btn-copy">Copy Structure</button>
                </div>
                <pre><code>&lt;<span class="t-tag">body</span>&gt;
    &lt;<span class="t-tag">div</span> <span class="t-attr">class</span>=<span class="t-val">"dashboard-container"</span>&gt;
        
        <span class="t-cm">&lt;!-- SIDEBAR NAVIGATION --&gt;</span>
        &lt;<span class="t-tag">div</span> <span class="t-attr">class</span>=<span class="t-val">"sidebar-wrapper"</span>&gt;
             <span class="t-cm">&lt;!-- ... sidebar content ... --&gt;</span>
        &lt;/<span class="t-tag">div</span>&gt;

        <span class="t-cm">&lt;!-- MAIN APP AREA --&gt;</span>
        &lt;<span class="t-tag">main</span> <span class="t-attr">class</span>=<span class="t-val">"main-content"</span>&gt;
            &lt;<span class="t-tag">div</span> <span class="t-attr">class</span>=<span class="t-val">"topbar"</span>&gt;...&lt;/<span class="t-tag">div</span>&gt;
            &lt;<span class="t-tag">div</span> <span class="t-attr">class</span>=<span class="t-val">"content-area"</span>&gt;
                 <span class="t-cm">&lt;!-- Halaman Anda Disini --&gt;</span>
            &lt;/<span class="t-tag">div</span>&gt;
        &lt;/<span class="t-tag">main</span>&gt;

    &lt;/<span class="t-tag">div</span>&gt;
&lt;/<span class="t-tag">body</span>&gt;</code></pre>
            </div>
        </section>

        <section id="api-datatable" class="section-card">
            <div class="section-header">
                <div class="section-icon"><i class="fas fa-table-list"></i></div>
                <h2 class="section-title">KudaKit: DataTables</h2>
            </div>
            <p class="text-muted mb-4">Gunakan helper <code>KudaKit.initDataTable()</code> untuk mendapatkan fitur filter kolom otomatis yang sudah disesuaikan dengan desain Kuda.</p>
            
            <div class="code-container">
                <div class="code-header">
                    <span class="code-lang">JavaScript</span>
                </div>
<pre><code><span class="t-cm">// Inisialisasi tabel dengan ID 'myTable'</span>
KudaKit.initDataTable('myTable', {
    pageLength: 25,
    order: [[0, 'desc']]
});</code></pre>
            </div>
            
            <div class="alert alert-info border-0 mt-3 d-flex align-items-start gap-3" style="background: rgba(14, 165, 233, 0.1); color: #0ea5e9;">
                <i class="fas fa-info-circle mt-1"></i>
                <div class="small fw-semibold">Tips: Tambahkan tag attribute data-search="true" pada tag TH di thead Anda untuk mengaktifkan shortcut filter pencarian khusus pada kolom tersebut.</div>
            </div>
        </section>

        <section id="api-charts" class="section-card">
            <div class="section-header">
                <div class="section-icon"><i class="fas fa-chart-pie"></i></div>
                <h2 class="section-title">KudaKit: ApexCharts</h2>
            </div>
            <p class="text-muted mb-4">Rendering grafik yang mengikuti state dark/light mode secara dinamis melalui interface <code>initChart()</code>.</p>
            <div class="code-container">
                <div class="code-header"><span class="code-lang">JavaScript</span></div>
<pre><code>KudaKit.initChart('#salesChart', {
    chart: { type: 'area', height: 400 },
    series: [{ name: 'Sales', data: [31, 40, 28, 51, 42] }],
    xaxis: { categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'] }
});</code></pre>
            </div>
        </section>

        <footer class="py-5 text-center text-muted">
            <p class="small">&copy; 2026 Kuda Admin Framework. Designed for Performance & Aesthetics.</p>
        </footer>

    </main>
</div>

@section Scripts {
<script>
    // Simple Smooth Scroll Logic for Sidebar
    document.querySelectorAll('.doc-link').forEach(link => {
        link.addEventListener('click', function(e) {
            document.querySelectorAll('.doc-link').forEach(l => l.classList.remove('active'));
            this.classList.add('active');
        });
    });

    // Observer to track current section
    const observer = new IntersectionObserver((sections) => {
        sections.forEach(section => {
            if (section.isIntersecting) {
                const id = section.target.getAttribute('id');
                const link = document.querySelector(`.doc-link[href="#${id}"]`);
                if (link) {
                    document.querySelectorAll('.doc-link').forEach(l => l.classList.remove('active'));
                    link.classList.add('active');
                }
            }
        });
    }, { threshold: 0.5 });

    document.querySelectorAll('section').forEach(section => observer.observe(section));
</script>
}
