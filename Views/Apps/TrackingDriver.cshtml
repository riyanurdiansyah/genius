<script>
document.addEventListener('DOMContentLoaded', function () {

  // ─── Fleet Data ───────────────────────────────────────────────
  const fleets = [
    {
      id: 1, name: 'Hino 500', plate: 'ALX-9012',
      driver: 'David Robertson', color: '#3b82f6',
      speed: 62, fuel: 78, status: 'Moving',
      from: [-6.2088, 106.8456], // Jakarta
      to:   [-6.9147, 107.6098], // Bandung
      progress: 65
    },
    {
      id: 2, name: 'Volvo FH16', plate: 'BRD-4451',
      driver: 'Andi Pratama', color: '#10b981',
      speed: 0, fuel: 32, status: 'Idling',
      from: [-7.2575, 112.7521], // Surabaya
      to:   [-7.9666, 112.6326], // Malang
      progress: 42
    },
    {
      id: 3, name: 'Isuzu Elf', plate: 'CZT-8891',
      driver: 'Rudi Santoso', color: '#f59e0b',
      speed: 12, fuel: 15, status: 'Delay',
      from: [-6.9932, 110.4203], // Semarang
      to:   [-7.5755, 110.8243], // Solo
      progress: 10
    },
    {
      id: 4, name: 'Scania R450', plate: 'D-8890-WX',
      driver: 'Budi Setiawan', color: '#8b5cf6',
      speed: 45, fuel: 90, status: 'Moving',
      from: [-6.1751, 106.8272], // Jakarta Kota
      to:   [-6.1781, 106.6297], // Tangerang
      progress: 12
    }
  ];

  const statusBadge = {
    'Moving': '<span class="badge bs-green">Moving</span>',
    'Idling': '<span class="badge bs-amber">Idling</span>',
    'Delay':  '<span class="badge bs-red">Delay</span>'
  };

  // ─── Initialize Map ───────────────────────────────────────────
  var map = L.map('leafMap', { zoomControl: false, attributionControl: false }).setView([-6.9, 108.5], 7);
  L.control.zoom({ position: 'topright' }).addTo(map);

  L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
    subdomains: 'abcd', maxZoom: 19
  }).addTo(map);

  // ─── Warehouse Icon ───────────────────────────────────────────
  const warehouseIcon = L.divIcon({
    className: '',
    html: `<div style="
      background:white; border-radius:12px; width:48px; height:48px;
      display:flex; align-items:center; justify-content:center;
      box-shadow:0 6px 20px rgba(0,0,0,0.25); border:2px solid #e2e8f0;
      overflow:hidden;">
      <img src="/images/warehouse-marker.png" style="width:42px;height:42px;object-fit:cover;border-radius:8px;">
    </div>`,
    iconSize: [48, 48], iconAnchor: [24, 48], popupAnchor: [0, -50]
  });

  // ─── Truck Icon factory ───────────────────────────────────────
  function truckIcon(color, label) {
    return L.divIcon({
      className: '',
      html: `<div style="position:relative;">
        <div style="
          background:${color}; color:white; border-radius:10px;
          width:38px; height:38px; display:flex; align-items:center;
          justify-content:center; box-shadow:0 6px 18px rgba(0,0,0,0.3);
          border:2px solid white; font-size:1rem;">
          <i class="fas fa-truck"></i>
        </div>
        <div style="
          position:absolute; bottom:-22px; left:50%; transform:translateX(-50%);
          background:${color}; color:white; padding:1px 7px; border-radius:4px;
          font-size:0.6rem; font-weight:700; white-space:nowrap;
          box-shadow:0 2px 6px rgba(0,0,0,0.2); border:1px solid white;">
          ${label}
        </div>
      </div>`,
      iconSize: [38, 50], iconAnchor: [19, 19], popupAnchor: [0, -30]
    });
  }

  // ─── Format duration ──────────────────────────────────────────
  function fmtDuration(seconds) {
    if (!seconds) return '—';
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    return h > 0 ? `~${h}h ${m}m` : `~${m}m`;
  }
  function fmtDist(meters) {
    if (!meters) return '—';
    return meters >= 1000 ? (meters/1000).toFixed(1)+' km' : meters+' m';
  }
  function arrivalTime(seconds) {
    const now = new Date();
    now.setSeconds(now.getSeconds() + seconds);
    return now.toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'}) + ' WIB';
  }

  // ─── ETA storage ──────────────────────────────────────────────
  const etaData = {};

  // ─── Render Truck List ────────────────────────────────────────
  function renderTruckList(activeId) {
    const list = document.getElementById('truck-list');
    list.innerHTML = '';
    fleets.forEach(f => {
      const isActive = f.id === activeId;
      const eta = etaData[f.id];
      const etaTxt = eta ? fmtDuration(eta.duration) : '—';
      list.innerHTML += `
        <div class="truck-card ${isActive ? 'active' : ''}" style="border-color:${isActive ? f.color : 'transparent'};" onclick="focusTruck(${f.id})">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <span class="fw-bold small">${f.name}</span>
              <div class="text-muted" style="font-size:.7rem;"><i class="fas fa-id-card me-1"></i>${f.plate}</div>
            </div>
            ${statusBadge[f.status] || ''}
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="text-muted" style="font-size:.72rem;"><i class="fas fa-gas-pump me-1"></i>${f.fuel}% Fuel</div>
              <div class="text-muted" style="font-size:.72rem;"><i class="fas fa-clock me-1"></i>ETA: <span class="fw-bold" style="color:${f.color};">${etaTxt}</span></div>
            </div>
            <div class="speed-ring" style="--tc:${f.color};border-top-color:${f.color};">${f.speed}</div>
          </div>
        </div>`;
    });
  }

  // ─── ETA strip in floating card ───────────────────────────────
  function updateEtaStrip() {
    const strip = document.getElementById('eta-strip');
    strip.innerHTML = fleets.map(f => {
      const eta = etaData[f.id];
      const txt = eta ? fmtDuration(eta.duration) : '…';
      return `<div class="eta-badge" style="background:${f.color}18;color:${f.color};">
        <span style="width:6px;height:6px;background:${f.color};border-radius:50%;display:inline-block;"></span>
        ${f.name.split(' ')[0]}: ${txt}
      </div>`;
    }).join('');
  }

  // ─── Route control per truck ──────────────────────────────────
  let activeId = 1;
  const controls = {};

  fleets.forEach(f => {
    // Truck marker
    const marker = L.marker(f.from, { icon: truckIcon(f.color, f.plate) })
      .addTo(map)
      .bindPopup(`<b style='color:${f.color}'>${f.name}</b><br>Driver: ${f.driver}<br>Plate: ${f.plate}<br>Speed: ${f.speed} km/h<br>Fuel: ${f.fuel}%`);

    // Destination warehouse marker
    L.marker(f.to, { icon: warehouseIcon })
      .addTo(map)
      .bindPopup(`<b>🏭 Warehouse Destination</b><br>Fleet: ${f.name}<br>Plate: ${f.plate}`);

    // OSRM Routing
    const ctrl = L.Routing.control({
      waypoints: [
        L.latLng(f.from[0], f.from[1]),
        L.latLng(f.to[0],   f.to[1])
      ],
      router: L.Routing.osrmv1({
        serviceUrl: 'https://router.project-osrm.org/route/v1',
        profile: 'driving'
      }),
      lineOptions: {
        styles: [{ color: f.color, weight: 5, opacity: 0.85 }],
        extendToWaypoints: true,
        missingRouteTolerance: 0
      },
      createMarker: () => null,   // hide default markers
      addWaypoints: false,
      fitSelectedRoutes: false,
      showAlternatives: false
    }).addTo(map);

    controls[f.id] = ctrl;

    ctrl.on('routesfound', function (e) {
      const route = e.routes[0];
      const dur   = route.summary.totalTime;
      const dist  = route.summary.totalDistance;
      etaData[f.id] = { duration: dur, distance: dist };

      // Update glass cards
      const elEta = document.getElementById('eta-t'+f.id);
      if (elEta) elEta.textContent = fmtDuration(dur);
      const elTbl = document.getElementById('tbl-eta'+f.id);
      if (elTbl) elTbl.textContent = fmtDuration(dur);

      // Update control room route bar for truck 1
      if (f.id === 1) {
        document.getElementById('route-dist').textContent = fmtDist(dist);
        document.getElementById('route-eta').textContent  = fmtDuration(dur) + ' remaining';
        document.getElementById('route-arr').textContent  = 'Arrive ' + arrivalTime(dur);
      }

      updateEtaStrip();
      renderTruckList(activeId);
    });

    ctrl.on('routingerror', function () {
      // Fallback straight polyline
      L.polyline([f.from, f.to], {
        color: f.color, weight: 5, opacity: 0.7, dashArray: '12, 8'
      }).addTo(map);
    });
  });

  // ─── Focus truck ──────────────────────────────────────────────
  window.focusTruck = function(id) {
    activeId = id;
    const f = fleets.find(x => x.id === id);
    document.getElementById('card-driver').textContent = f.driver;
    document.getElementById('card-plate').textContent  = f.name + ' · ' + f.plate;
    document.getElementById('card-speed').textContent  = f.speed + ' km/h';
    const eta = etaData[id];
    document.getElementById('card-dist').textContent   = eta ? fmtDist(eta.distance) : '—';
    document.getElementById('card-time').textContent   = eta ? 'ETA ' + arrivalTime(eta.duration) : 'Calculating…';
    map.setView(f.from, 11);
    renderTruckList(id);
  };

  // ─── Initial render ───────────────────────────────────────────
  renderTruckList(activeId);

  // Fit all trucks
  const allBounds = L.latLngBounds(fleets.map(f => f.from).concat(fleets.map(f => f.to)));
  map.fitBounds(allBounds, { padding: [60, 60] });
});
</script>
