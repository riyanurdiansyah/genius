      <div class="pipe-col">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="fw-bold small text-uppercase text-primary">Completed</span>
          <span class="badge bg-primary text-white rounded-pill">12</span>
        </div>
        <div class="pipe-row bg-light bg-opacity-50">
          <div class="d-flex justify-content-between mb-1"><small class="text-primary fw-bold">#ORD-099</small><small class="text-muted">Delivered</small></div>
          <div class="fw-bold small text-muted mb-1">Jakarta → Bekasi</div>
          <div class="d-flex justify-content-between align-items-center">
            <div class="text-muted" style="font-size:.72rem;">Done 15:45</div>
            <i class="fas fa-check-circle text-primary small"></i>
          </div>
