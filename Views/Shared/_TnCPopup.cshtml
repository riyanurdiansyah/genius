<style>
    #tncModalOverlay {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(6, 11, 20, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 10000;
        display: none;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        padding: 20px;
    }

    #tncModalOverlay.show {
        display: flex;
        opacity: 1;
    }

    .tnc-modal-card {
        background: rgba(255, 255, 255, 0.95);
        width: 100%;
        max-width: 600px;
        max-height: 90vh;
        border-radius: 28px;
        box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.4);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.4);
        transform: translateY(40px) scale(0.95);
        transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    [data-theme="dark"] .tnc-modal-card {
        background: rgba(15, 38, 32, 0.9);
        color: #f1f5f9;
        border-color: rgba(59, 157, 130, 0.2);
    }

    #tncModalOverlay.show .tnc-modal-card {
        transform: translateY(0) scale(1);
    }

    .tnc-modal-header {
        padding: 32px 40px;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: transparent;
    }
    [data-theme="dark"] .tnc-modal-header { border-bottom-color: rgba(255,255,255,0.05); }

    .tnc-modal-header h2 {
        font-family: 'KalbeGeometric', sans-serif;
        font-size: 1.5rem;
        font-weight: 800;
        margin: 0;
        color: #0f172a;
        letter-spacing: -0.5px;
        display: flex; align-items: center; gap: 12px;
    }
    .tnc-modal-header h2 i { color: var(--primary); }
    [data-theme="dark"] .tnc-modal-header h2 { color: #ffffff; }

    .tnc-modal-close {
        width: 36px; height: 36px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        color: #94a3b8;
        background: #f1f5f9;
        transition: all 0.3s;
    }
    .tnc-modal-close:hover { color: #f8fafc; background: #ef4444; transform: rotate(90deg); }
    [data-theme="dark"] .tnc-modal-close { background: rgba(0,0,0,0.2); }

    .tnc-modal-body {
        padding: 20px 40px 40px 40px;
        overflow-y: auto;
        font-size: 0.95rem;
        line-height: 1.8;
        color: #475569;
        scrollbar-width: none;
    }
    [data-theme="dark"] .tnc-modal-body { color: #cbd5e1; }
    .tnc-modal-body::-webkit-scrollbar { display: none; }

    .tnc-point {
        margin-bottom: 35px;
        position: relative;
        padding-left: 20px;
    }
    .tnc-point::before {
        content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
        background: linear-gradient(to bottom, var(--primary), transparent);
        border-radius: 10px;
    }
    .tnc-point h3 {
        font-family: 'KalbeGeometric', sans-serif;
        font-weight: 700;
        font-size: 1.1rem;
        color: #1e293b;
        margin-bottom: 8px;
    }
    [data-theme="dark"] .tnc-point h3 { color: #f8fafc; }

    .tnc-point p { margin-bottom: 0; opacity: 0.8; }

    .tnc-modal-footer {
        padding: 32px 40px;
        background: rgba(255,255,255,0.5);
        display: flex;
        flex-direction: column;
        gap: 20px;
        border-top: 1px solid rgba(0,0,0,0.05);
    }
    [data-theme="dark"] .tnc-modal-footer { background: rgba(0,0,0,0.1); border-top-color: rgba(255,255,255,0.05); }

    .tnc-cb-wrapper {
        display: flex; 
        align-items: center; 
        gap: 15px; 
        cursor: pointer;
        padding: 15px 20px;
        background: #f8fafc;
        border-radius: 16px;
        border: 1px solid transparent;
        transition: all 0.3s;
    }
    [data-theme="dark"] .tnc-cb-wrapper { background: rgba(0,0,0,0.2); }
    .tnc-cb-wrapper:hover { border-color: var(--primary); background: #fdfdfd; }
    [data-theme="dark"] .tnc-cb-wrapper:hover { background: rgba(0,0,0,0.3); }

    .tnc-cb-wrapper input { 
        width: 22px; height: 22px; 
        accent-color: var(--primary); 
        cursor: pointer;
    }
    
    .tnc-cb-text { font-size: 0.95rem; font-weight: 600; color: #334155; }
    [data-theme="dark"] .tnc-cb-text { color: #f1f5f9; }

    .btn-accept-modern {
        background: var(--primary);
        color: white;
        border: none;
        padding: 16px;
        border-radius: 16px;
        font-family: 'KalbeGeometric', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1);
        box-shadow: 0 10px 20px -5px rgba(59, 157, 130, 0.4);
        display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .btn-accept-modern:hover:not(:disabled) {
        background: var(--primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 15px 30px -5px rgba(59, 157, 130, 0.5);
    }
    .btn-accept-modern:active { transform: scale(0.98); }
    .btn-accept-modern:disabled {
        background: #94a3b8; box-shadow: none; cursor: not-allowed; opacity: 0.6;
    }

</style>

<div class="tnc-modal-overlay" id="tncModalOverlay">
    <div class="tnc-modal-card">
        <div class="tnc-modal-header">
            <h2><i class="fas fa-shield-halved"></i> Terms of Protocol</h2>
            <div class="tnc-modal-close" onclick="closeTnC()">
                <i class="fas fa-times"></i>
            </div>
        </div>

        <div class="tnc-modal-body">
            <div class="tnc-point">
                <h3>01. General Scope</h3>
                <p>Welcome to Kuda Admin. These terms govern the professional relationship and system access standards of our workspace.</p>
            </div>

            <div class="tnc-point">
                <h3>02. System Integrity</h3>
                <p>Users are expected to maintain the stability of the platform. Any attempt at automated scraping or unauthorized extraction is prohibited.</p>
            </div>

            <div class="tnc-point">
                <h3>03. Intellectual Protection</h3>
                <p>The dashboard’s architecture and visual blueprints are proprietary property. Professional usage is granted through your authenticated license.</p>
            </div>

            <div class="tnc-point" style="margin-bottom:0;">
                <h3>04. Data Sovereignty</h3>
                <p>Your telemetric data is protected by Tier-4 encryption standards, ensuring absolute privacy for your business logic.</p>
            </div>
        </div>

        <div class="tnc-modal-footer">
            <div class="tnc-cb-wrapper" onclick="document.getElementById('popupAcceptCheck').click(); event.stopPropagation();">
                <input type="checkbox" id="popupAcceptCheck" onclick="event.stopPropagation();">
                <div class="tnc-cb-text">I acknowledge and accept the protocol</div>
            </div>
            <button class="btn-accept-modern" id="popupAcceptBtn" disabled onclick="acceptTnC()">
                <span>Access Dashboard</span>
                <i class="fas fa-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

<script>
function openTnC() {
        const overlay = document.getElementById('tncModalOverlay');
        overlay.style.display = 'flex';
        setTimeout(() => overlay.classList.add('show'), 10);
        document.body.style.overflow = 'hidden';
    }

    function closeTnC() {
        const overlay = document.getElementById('tncModalOverlay');
        overlay.classList.remove('show');
        setTimeout(() => {
            overlay.style.display = 'none';
            document.body.style.overflow = '';
        }, 300);
    }

    document.getElementById('popupAcceptCheck').addEventListener('change', function() {
        document.getElementById('popupAcceptBtn').disabled = !this.checked;
    });

    function acceptTnC() {
        const btn = document.getElementById('popupAcceptBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Initializing...';

        setTimeout(() => {
            closeTnC();
            if (window.onTnCAccepted) window.onTnCAccepted();
        }, 800);
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && document.getElementById('tncModalOverlay').classList.contains('show')) {
            closeTnC();
        }
    });

</script>
