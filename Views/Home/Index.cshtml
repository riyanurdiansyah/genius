@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .chart-box { min-height: 300px; background: #f8fbfa; display:flex; align-items:center; justify-content:center; border-radius: 12px; }
    .progress-track { height: 8px; background: #e9ecef; border-radius: 4px; }
    [data-theme="dark"] .chart-box { background: rgba(59, 157, 130, 0.03) !important; border: 1px solid rgba(59, 157, 130, 0.1); }
    [data-theme="dark"] .progress-track { background: rgba(255,255,255,0.08) !important; }
    [data-theme="dark"] .card {
        background: rgba(59, 157, 130, 0.05) !important;
        border-color: rgba(59, 157, 130, 0.1) !important;
    }
    .stat-card { display: flex; align-items: center; gap: 15px; }
    .stat-icon { width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0; transition: all 0.3s; }
    .card:hover .stat-icon { transform: scale(1.05); }
    
    .bg-green-soft { background: rgba(59, 157, 130, 0.1); color: var(--primary); }
    .bg-teal-soft { background: rgba(45, 212, 191, 0.1); color: #0d9488; }
    .bg-emerald-soft { background: rgba(16, 185, 129, 0.1); color: #059669; }
    .bg-lime-soft { background: rgba(132, 204, 22, 0.1); color: #65a30d; }

    [data-theme="dark"] .bg-green-soft { background: rgba(59, 157, 130, 0.2); }
    [data-theme="dark"] .bg-teal-soft { background: rgba(45, 212, 191, 0.2); }
    [data-theme="dark"] .bg-emerald-soft { background: rgba(16, 185, 129, 0.2); }
    [data-theme="dark"] .bg-lime-soft { background: rgba(132, 204, 22, 0.2); }

</style>

<div class="row mb-4">

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card h-100 border-0 shadow-sm" style="border-radius: 20px;">
            <div class="card-body stat-card">
                <div class="stat-icon bg-green-soft">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <h6 class="text-secondary mb-1 fw-semibold" style="font-size: 13px;">Total Users</h6>
                    <h3 class="mb-0 fw-bold" style="letter-spacing: -0.5px;">1,245</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card h-100 border-0 shadow-sm" style="border-radius: 20px;">
            <div class="card-body stat-card">
                <div class="stat-icon bg-teal-soft">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div>
                    <h6 class="text-secondary mb-1 fw-semibold" style="font-size: 13px;">New Orders</h6>
                    <h3 class="mb-0 fw-bold" style="letter-spacing: -0.5px;">382</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card h-100 border-0 shadow-sm" style="border-radius: 20px;">
            <div class="card-body stat-card">
                <div class="stat-icon bg-emerald-soft">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div>
                    <h6 class="text-secondary mb-1 fw-semibold" style="font-size: 13px;">Total Revenue</h6>
                    <h3 class="mb-0 fw-bold" style="letter-spacing: -0.5px;">$45,210</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card h-100 border-0 shadow-sm" style="border-radius: 20px;">
            <div class="card-body stat-card">
                <div class="stat-icon bg-lime-soft">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div>
                    <h6 class="text-secondary mb-1 fw-semibold" style="font-size: 13px;">Growth Rate</h6>
                    <h3 class="mb-0 fw-bold" style="letter-spacing: -0.5px;">+24.8%</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">

    <div class="col-lg-8 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Revenue Overview</span>
                <button class="btn btn-sm btn-outline-primary"><i class="fas fa-download"></i> Export</button>
            </div>
            <div class="card-body chart-box">
                <p class="text-muted"><i class="fas fa-chart-bar fs-1 mb-2 d-block text-center"></i> Chart Placeholder</p>

            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header">
                System Health
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary" style="font-size: 13px;">CPU Usage</span>
                        <span class="fw-bold">45%</span>
                    </div>
                    <div class="progress-track progress">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 45%; height: 100%; border-radius: 4px;" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary" style="font-size: 13px;">Memory Usage</span>
                        <span class="fw-bold">75%</span>
                    </div>
                    <div class="progress-track progress">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: 75%; height: 100%; border-radius: 4px;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary" style="font-size: 13px;">Disk Space</span>
                        <span class="fw-bold">20%</span>
                    </div>
                    <div class="progress-track progress">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 20%; height: 100%; border-radius: 4px;" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">Recent Orders</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>#ORD-001</td>
                                <td>John Doe</td>
                                <td>Oct 24, 2023</td>
                                <td><span class="badge bg-success">Completed</span></td>
                                <td>$120.50</td>
                                <td><button class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></button></td>
                            </tr>
                            <tr>
                                <td>#ORD-002</td>
                                <td>Jane Smith</td>
                                <td>Oct 23, 2023</td>
                                <td><span class="badge bg-warning text-dark">Pending</span></td>
                                <td>$45.00</td>
                                <td><button class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></button></td>
                            </tr>
                            <tr>
                                <td>#ORD-003</td>
                                <td>Mike Johnson</td>
                                <td>Oct 22, 2023</td>
                                <td><span class="badge bg-danger">Cancelled</span></td>
                                <td>$210.00</td>
                                <td><button class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
